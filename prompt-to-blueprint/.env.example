# === Prompt-to-Blueprint AI — Environment Variables ===

# --- Backend ---
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
SECRET_KEY=change-me-in-production
DEBUG=true

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- Ollama ---
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT=30

# --- Model Paths ---
GNN_MODEL_PATH=models/floorplan_gnn.pt
GNN_CHECKPOINT_DIR=models/

# --- Worker ---
RQ_QUEUE_NAME=layout
JOB_TTL=86400

# --- Frontend ---
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
